# Copy to .env.local and fill in. Never commit the filled copy.
# Everything here is NEXT_PUBLIC_, so it ships to the browser: no secrets.

# Required — Supabase project (Settings > API). The anon key is the public one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required — where the FastAPI service answers.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical origin, used for absolute URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — analytics. Without a key, the client does not start.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional — mirrors the backend per page cap for Google Place photos.
NEXT_PUBLIC_GOOGLE_PLACE_PHOTO_PER_PAGE_LIMIT=10
